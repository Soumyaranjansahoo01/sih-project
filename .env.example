# Application Settings
APP_NAME="SIH26027 - Indian Railways Block Planning Optimizer"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Settings
# For local development SQLite is default fallback
DATABASE_URL=sqlite:///./backend/railway.db
# For PostgreSQL (Production):
# DATABASE_URL=postgresql://user:password@localhost:5432/ir_block_planning

# Optimization Settings
SOLVER_TIME_LIMIT_SECONDS=60
DEFAULT_PLANNING_HORIZON_DAYS=7
DEFAULT_MIN_BLOCK_DURATION_MINUTES=60
DEFAULT_MAX_BLOCK_DURATION_MINUTES=240

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
